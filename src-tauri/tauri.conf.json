{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "持有",
  "version": "0.1.0-alpha.1",
  "identifier": "app.heldledger.desktop",
  "build": { "frontendDist": "../demo" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false } },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
